# Configure these as environment variables locally or in Railway.
# Keep existing host, database and security options; do not also set serverTimezone.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/compost_system?useSSL=false&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&preserveInstants=true&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
# On Railway set EMAIL_PROVIDER=gmail-api, then authorize the GMAIL_USERNAME account.
EMAIL_PROVIDER=auto
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Optional alternative HTTPS provider, not required for Gmail API.
RESEND_API_KEY=
RESEND_FROM_EMAIL=IoT Compost Accelerator <onboarding@resend.dev>
NOTIFICATION_EMAIL=
APP_FRONTEND_URL=http://localhost:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
